# Maintainer: TheElevatedOne <adam.mlady@elevated.ovh>
pkgbase=reshade-linux-git
pkgname=(reshade-linux-git lib32-reshade-linux-git)
_pkgname=reshade-linux
pkgver=6.8.0.1_r0_g8a5abb7c
pkgrel=1
pkgdesc="crosire's ReShade post-processing injector as a native Vulkan layer, enabled with RESHADE=1 (works with Proton via DXVK/VKD3D) (git version)"
arch=('x86_64')
url="https://github.com/TheElevatedOne/reshade-linux"
license=('BSD-3-Clause')
makedepends=('git' 'cmake' 'ninja' 'gcc' 'pkgconf' 'python' 'python-jinja'
             'libx11' 'libxcb' 'libxkbcommon' 'wayland' 'dbus'
             'lib32-gcc-libs' 'lib32-glibc' 'lib32-libx11' 'lib32-libxcb' 'lib32-libxkbcommon' 'lib32-wayland' 'lib32-dbus')
source=("${_pkgname}::git+${url}.git"
        "imgui::git+https://github.com/ocornut/imgui.git"
        "stb::git+https://github.com/nothings/stb.git"
        "glad::git+https://github.com/Dav1dde/glad.git"
        "utfcpp::git+https://github.com/nemtrif/utfcpp.git"
        "spirv::git+https://github.com/KhronosGroup/SPIRV-Headers.git"
        "vma::git+https://github.com/GPUOpen-LibrariesAndSDKs/VulkanMemoryAllocator.git"
        "fpng::git+https://github.com/richgel999/fpng.git"
        "jxl_simple_lossless::git+https://github.com/kampidh/simple-lossless-encoder.git")
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

pkgver() {
  cd "${_pkgname}"
  (
    set -o pipefail
    git describe --long --tags --abbrev=8 2>/dev/null | sed 's/\([^-]*-g\)/r\1/;s/-/_/g' ||
      printf 'r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=8 HEAD)"
  )
}

prepare() {
  cd "${_pkgname}"
  local submodule
  for submodule in imgui stb glad utfcpp spirv vma fpng jxl_simple_lossless; do
    git submodule init "deps/${submodule}"
    git config "submodule.${submodule}.url" "${srcdir}/${submodule}"
  done
  git -c protocol.file.allow=always submodule update
}

build() {
  cmake -S "${_pkgname}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib
  cmake --build build

  # 32-bit layer for 32-bit games (including 32-bit Proton games)
  cmake -S "${_pkgname}" -B build32 -G Ninja \
    -DCMAKE_TOOLCHAIN_FILE="${srcdir}/${_pkgname}/linux/toolchain-i686.cmake" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib32 \
    -DRESHADE_INSTALL_SHARED_FILES=OFF
  cmake --build build32
}

package_reshade-linux-git() {
  depends=('glibc' 'libxcb' 'libxkbcommon' 'wayland' 'dbus' 'vulkan-icd-loader' 'bash' 'git')
  optdepends=(
    'lib32-reshade-linux-git: 32-bit games'
    'curl: download the depth buffer compatibility list with reshade --download-shaders'
    'xdg-desktop-portal: global shortcuts (e.g. xdg-desktop-portal-kde or xdg-desktop-portal-hyprland)'
    'pipewire-audio: screenshot sound (pw-play)'
    'xdg-utils: open folders and links from the overlay'
  )
  provides=("${pkgname%-git}")
  conflicts=("${pkgname%-git}")

  DESTDIR="${pkgdir}" cmake --install build
  install -Dm644 "${_pkgname}/README.md" "${pkgdir}/usr/share/doc/${pkgname%-git}/README.md"
  install -Dm644 "${_pkgname}/LICENSE.md" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.md"
}

package_lib32-reshade-linux-git() {
  pkgdesc="crosire's ReShade post-processing injector as a native Vulkan layer (32-bit) (git version)"
  depends=('reshade-linux' 'lib32-glibc' 'lib32-libxcb' 'lib32-libxkbcommon' 'lib32-wayland' 'lib32-dbus' 'lib32-vulkan-icd-loader')
  provides=("${pkgname%-git}")
  conflicts=("${pkgname%-git}")

  DESTDIR="${pkgdir}" cmake --install build32
  install -Dm644 "${_pkgname}/LICENSE.md" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.md"
}
