{
	"file_format_version": "1.0.0",
	"layer": {
		"name": "@RESHADE_LAYER_NAME@_@RESHADE_ARCH@",
		"type": "GLOBAL",
		"library_path": "@CMAKE_INSTALL_FULL_LIBDIR@/reshade/libreshade.so",
		"api_version": "1.4.309",
		"implementation_version": "1",
		"description": "crosire's ReShade post-processing injector (Linux, @RESHADE_ARCH@)",
		"functions": {
			"vkGetInstanceProcAddr": "vkGetInstanceProcAddr",
			"vkGetDeviceProcAddr": "vkGetDeviceProcAddr"
		},
		"device_extensions": [
			{
				"name": "VK_EXT_tooling_info",
				"spec_version": "1",
				"entrypoints": [ "vkGetPhysicalDeviceToolPropertiesEXT" ]
			}
		],
		"enable_environment": {
			"RESHADE": "1"
		},
		"disable_environment": {
			"DISABLE_RESHADE": "1"
		}
	}
}
